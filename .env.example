DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=Shepherd_one
DB_SYNCHRONIZE=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Default admin (seeded on startup if not already in DB)
ADMIN_EMAIL=admin@churchapp.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_MIDDLE_NAME=
ADMIN_LAST_NAME=Admin

# RBAC: set true to re-sync system role permissions from systemRoles.json on boot
RBAC_RESEED_SYSTEM=false

# Auth: set true to allow public POST /auth/register (disabled by default)
ALLOW_PUBLIC_REGISTER=false

# Cloud storage: true = Cloudinary, false = local uploads/ + Sharp (default)
# On Render/512MB hosts set CLOUD_STORAGE=true and fill CLOUDINARY_* (do not leave false).
CLOUD_STORAGE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
